{
  "name": "trading-bot",
  "version": "1.0.0",
  "description": "Cryptocurrency trading bot with technical analysis and risk management",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/fetch-data.ts",
    "test": "vitest run && npm --prefix src/dashboard/ui run test",
    "test:watch": "vitest",
    "test:ui": "npm --prefix src/dashboard/ui run test",
    "fetch": "tsx src/cli/fetch-data.ts",
    "sync": "tsx src/cli/fetch-data.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "report": "tsx src/cli/report.ts",
    "tournament": "tsx src/cli/tournament.ts",
    "optimize": "tsx src/cli/optimize.ts",
    "paper": "tsx src/cli/paper.ts",
    "live": "tsx src/cli/live.ts",
    "build:ui": "npm --prefix src/dashboard/ui run build",
    "prestart": "test -f dist/dashboard/index.html || npm run build:ui",
    "start": "tsx src/cli/start.ts",
    "predashboard": "test -f dist/dashboard/index.html || npm run build:ui",
    "dashboard": "tsx src/cli/dashboard.ts",
    "check-gaps": "tsx src/cli/check-gaps.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.6.2",
    "coinbase-api": "^1.1.11",
    "commander": "^14.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "fast-technical-indicators": "^1.1.4",
    "fastify": "^5.7.4",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "simple-statistics": "^7.8.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.0.18"
  }
}
