# ── Coinbase Advanced Trade API ───────────────────────────────────────────────
# Required. Generate at: https://www.coinbase.com/settings/api
# Read-only key is sufficient for data sync and paper trading.
# Trading permissions required for live trading mode.
COINBASE_API_KEY_NAME=organizations/xxx/apiKeys/yyy
COINBASE_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# ── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file. Created automatically on first run.
DB_PATH=./data/trading.db

# ── Data Pipeline ─────────────────────────────────────────────────────────────
# Comma-separated list of trading pairs to sync and trade.
TRADING_PAIRS=BTC-USD,ETH-USD

# Number of days of historical candle data to fetch and retain.
HISTORY_DAYS=365

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Optional: CryptoCompare ───────────────────────────────────────────────────
# Only needed if using CryptoCompare as a secondary data source.
# Leave blank to disable.
CRYPTOCOMPARE_API_KEY=

# ── Coinbase FCM (Futures Commission Merchant) — Perpetual Futures ─────────────
# Available to US users via the Advanced Trade API.
# Reuses COINBASE_API_KEY_NAME / COINBASE_API_KEY_SECRET — no separate FCM keys needed.
FCM_ENABLED=false
FCM_TESTNET=false

# Perp trading mode: none | paper | live
# none  — perp pipeline is fully dormant (default, safe for spot-only users)
# paper — runs perp tournament + PaperPerpEngine alongside spot on npm start
# live  — runs perp tournament + PerpPositionManager (requires FCM_ENABLED=true)
PERP_MODE=none

# Path to the perp-specific SQLite database (separate from DB_PATH to avoid SQLITE_BUSY).
# Created automatically on first run when PERP_MODE is paper or live.
PERP_DB_PATH=./data/perp.db
