# ── Coinbase Advanced Trade API ───────────────────────────────────────────────
# Required. Generate at: https://www.coinbase.com/settings/api
# Read-only key is sufficient for data sync and paper trading.
# Trading permissions required for live trading mode.
COINBASE_API_KEY_NAME=organizations/xxx/apiKeys/yyy
COINBASE_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# ── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file. Created automatically on first run.
DB_PATH=./data/trading.db

# ── Data Pipeline ─────────────────────────────────────────────────────────────
# Comma-separated list of trading pairs to sync and trade.
TRADING_PAIRS=BTC-USD,ETH-USD

# Number of days of historical candle data to fetch and retain.
HISTORY_DAYS=365

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Optional: CryptoCompare ───────────────────────────────────────────────────
# Only needed if using CryptoCompare as a secondary data source.
# Leave blank to disable.
CRYPTOCOMPARE_API_KEY=
